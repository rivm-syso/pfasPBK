	Alung -> AArt_Plas;
	ASk -> AVen_Plas;
	AVen_Plas -> Alung;
	AArt_Plas -> ASk;
	AArt_Plas -> AGut;
	AArt_Plas -> ALiv;
	AArt_Plas -> AFat;
	AArt_Plas -> AKid;
	AArt_Plas -> AFil;
	AArt_Plas -> ARest;
	AGut -> ALiv;
	ALiv -> AVen_Plas;
	AFat -> AVen_Plas;
	AKid -> AVen_Plas;
	AFil -> AKid;
	AFil -> ADelay;
	ARest -> AVen_Plas;
	ADelay -> AUrine	[minlen=1];
