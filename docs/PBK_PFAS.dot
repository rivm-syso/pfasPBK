digraph {
	graph [ratio=fill,
		size="7,4"
	];
	node [fontname=Arial];
	subgraph cluster_Lung {
		graph [color=black,
			fillcolor=lightblue,
			fontname=Arial,
			href="#compartment-Lung",
			label=Lung,
			shape=box,
			style="filled,rounded"
		];
		Alung	[color=black,
			fillcolor=gold,
			href="#species-Alung",
			label=Alung,
			shape=box,
			style="filled,rounded"];
	}
